{
  "name": "my-gemmer-game",
  "version": "0.1.0",
  "main": "electron-main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.gemmer.game",
    "productName": "MyGemmerGame",
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "gemmer": "^0.2.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "vite": "^5.0.0"
  }
}
